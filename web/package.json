{
  "name": "my-known-world-web",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "docs:dev": "cd ../docs && npm run docs:dev",
    "docs:build": "cd ../docs && npm run docs:build",
    "build:all": "npm run build && npm run docs:build && mkdir -p dist/docs && cp -r ../docs/.vitepress/dist/* dist/docs/"
  },
  "dependencies": {
    "antd": "^6.7.1",
    "lucide-react": "latest",
    "marked": "^18.2.1",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
