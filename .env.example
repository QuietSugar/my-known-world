# Change this before starting Compose. Use a URL-safe password (letters, digits, - or _).
POSTGRES_PASSWORD=replace-with-a-long-random-password

# The app binds to localhost by default. Set APP_HOST_IP=0.0.0.0 only when needed.
APP_HOST_IP=127.0.0.1
APP_PORT=8080

# Fresh installs seed a synthetic sample graph so the UI opens immediately.
# Set to 0 only after loading a complete graph snapshot into PostgreSQL.
MYKNOWNWORLD_SEED_DEMO=1

# Optional: enable authenticated sync/review writes. Set a stable random value of at least 32 bytes.
# Generate locally with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
MYKNOWNWORLD_WRITE_TOKEN=

# Override to run a specific published image tag.
# The CMDB token is independent from MYKNOWNWORLD_WRITE_TOKEN. Replace it before startup.
CMDB_APP_TOKEN=replace-with-a-distinct-random-CMDB-token-of-at-least-32-chars
# Keep CMDB_SECRET_PROVIDER blank to disable credential operations.
# Supported values: file (built-in encrypted file provider) or http (your own
# provider service speaking the documented protocol). See docs/secret-providers.md.
CMDB_SECRET_PROVIDER=
# File provider: owner-only store directory plus a dedicated 32-byte key.
# Generate one with: openssl rand -base64 32
# Compose fixes the container path at /var/lib/mkw-vault (an ephemeral tmpfs);
# mount a persistent owner-only volume there if the vault must survive recreation.
CMDB_VAULT_DIR=/var/lib/mkw-vault
CMDB_VAULT_KEY_BASE64=
# Alternative to CMDB_VAULT_KEY_BASE64: an owner-only key file (not both).
CMDB_VAULT_KEY_FILE=
# Operator-supplied secret service (CMDB_SECRET_PROVIDER=http). It only needs to
# speak the small JSON contract in docs/secret-providers.md; loopback plaintext
# is accepted, any other host needs https (or the opt-in below).
CMDB_SECRET_HTTP_URL=
CMDB_SECRET_HTTP_TOKEN=
# Set to 1 to allow plaintext HTTP to a non-loopback host. Not for production.
CMDB_SECRET_HTTP_ALLOW_INSECURE=

IMAGE_TAG=v0.0.11
IMAGE_VERSION=0.0.11
