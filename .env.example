# Change this before starting Compose. Use a URL-safe password (letters, digits, - or _).
POSTGRES_PASSWORD=replace-with-a-long-random-password

# The app binds to localhost by default. Set APP_HOST_IP=0.0.0.0 only when needed.
APP_HOST_IP=127.0.0.1
APP_PORT=8080

# Fresh installs seed a synthetic sample graph so the UI opens immediately.
# Set to 0 only after loading a complete graph snapshot into PostgreSQL.
MYKNOWNWORLD_SEED_DEMO=1

# Optional: enable authenticated sync/review writes. Set a stable random value of at least 32 bytes.
# Generate locally with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
MYKNOWNWORLD_WRITE_TOKEN=

# Override to run a specific published image tag.
IMAGE_TAG=v0.0.2
IMAGE_VERSION=0.0.2
